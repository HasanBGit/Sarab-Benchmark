# Copy this file to .env and fill in your OpenRouter key.
# All five modes' evaluation scripts authenticate against OpenRouter with
# this one key; OpenRouter passes through each provider's own per-token
# price, so no separate Google/OpenAI/Qwen keys are needed.
# Get a key at https://openrouter.ai (Keys page).
#
# Never commit the real .env file.

OPENROUTER_API_KEY=

# Optional: point evaluation scripts at a local dataset checkout instead of
# downloading from the Hugging Face Hub. See README.md "Setup".
# SARAB_DATA_DIR=/path/to/Sarab-Dataset-HF
